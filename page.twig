{% extends 'master.twig' %}

{% block content %}

<!--
    =====================================================
    Blog Section Two
    =====================================================
  -->
<div class="blog-section-two position-relative z-1 pt-110 lg-pt-100 pb-150 lg-pb-100">
  <div class="container">
    <div class="title-one mb-80 lg-mb-40" data-sal="slide-up" data-sal-duration="800">
      <div class="upper-title">{{ record.title }}</div>
      <!--<h2>C’est la rééducation du geste graphique</h2>-->
      <h3>{{ record.teaser }}</h3>
    </div>
    <!-- /.title-one -->
  </div>

  <article class="blog-meta-one version-two" data-sal="slide-up" data-sal-duration="800">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-xxl-7 col-lg-6 order-lg-last">
          <div class="img-meta-two" style="background-image: url(images/blog/code_review.jpg);"></div>
        </div>
        <div class="col-lg-5">
          <div class="post-meta">
            {{ record.body }}
          </div>
          <!-- /.post-meta -->
        </div>
      </div>
    </div>
  </article>
  <!-- /.blog-meta-one -->
</div>
{% endblock content %}
